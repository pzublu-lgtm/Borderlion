efault();\r\n        // Here you would typically handle form submission, e.g., sending data to an API\r\n        setSubmitted(true);\r\n    };\r\n\r\n    return (\r\n        <div className=\"contact-form\">\r\n            {submitted ? (\r\n                <div className=\"thank-you-message\">\r\n                    <h2>Thank you for your message!</h2>\r\n                    <p>We'll get back to you soon.</p>\r\n                </div>\r\n            ) : (\r\n                <form onSubmit={handleSubmit}>\r\n                    <div>\r\n                        <label htmlFor=\"name\">Name:</label>\r\n                        <input\r\n                            type=\"text\"\r\n                            id=\"name\"\r\n                            value={name}\r\n                            onChange={(e) => setName(e.target.value)}\r\n                            required\r\n                        />\r\n                    </div>\r\n                    <div>\r\n                        <label htmlFor=\"email\">Email:</label>\r\n                        <input\r\n                            type=\"email\"\r\n                            id=\"email\"\r\n                            value={email}\r\n                            onChange={(e) => setEmail(e.target.value)}\r\n                            required\r\n                        />\r\n                    </div>\r\n                    <div>\r\n                        <label htmlFor=\"message\">Message:</label>\r\n                        <textarea\r\n                            id=\"message\"\r\n                            value={message}\r\n                            onChange={(e) => setMessage(e.target.value)}\r\n                            required\r\n                        />\r\n                    </div>\r\n                    <button type=\"submit\">Send Message</button>\r\n                </form>\r\n            )}\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default ContactForm;","import React from 'react';\r\n\r\nconst TextilePhilosophy: React.FC = () => {\r\n    return (\r\n        <div className=\"textile-philosophy\">\r\n            <h1>Textile Philosophies</h1>\r\n            <p>\r\n                Welcome to my exploration of textile philosophies. Here, I delve into the intricate relationship between textiles and culture, sustainability, and innovation. \r\n                Textiles are not just materials; they are narratives woven into the fabric of our lives. \r\n                Join me as I share insights, research, and reflections on the significance of textiles in our world.\r\n            </p>\r\n            <h2>Key Concepts</h2>\r\n            <ul>\r\n                <li>Sustainability in Textile Production</li>\r\n                <li>The Cultural Significance of Textiles</li>\r\n                <li>Innovative Textile Technologies</li>\r\n                <li>Textiles and Identity</li>\r\n            </ul>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default TextilePhilosophy;","import React from 'react';\r\nimport { BrowserRouter as Router, Route, Switch } from 'react-router-dom';\r\nimport Home from './pages/Home';\r\nimport ProjectsGrid from './components/ProjectsGrid';\r\nimport ResearchList from './components/ResearchList';\r\nimport ContactForm from './components/ContactForm';\r\nimport TextilePhilosophy from './components/TextilePhilosophy';\r\n\r\nconst App: React.FC = () => {\r\n  return (\r\n    <Router basename=\"/Borderlion\">\r\n      <Switch>\r\n        <Route exact path=\"/\" component={Home} />\r\n        <Route path=\"/projects\" component={ProjectsGrid} />\r\n        <Route path=\"/research\" component={ResearchList} />\r\n        <Route path=\"/contact\" component={ContactForm} />\r\n        <Route path=\"/textile-philosophy\" component={TextilePhilosophy} />\r\n      </Switch>\r\n    </Router>\r\n  );\r\n};\r\n\r\nexport default App;","import React from 'react';\r\nimport ReactDOM from 'react-dom';\r\nimport App from './App';\r\nimport 